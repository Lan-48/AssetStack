:root {
  --primary: #007AFF;
  --success: #34C759;
  --caution: #FFCC00;
  --warning: #FF9500;
  --danger: #FF3B30;
  --purple: #AF52DE;
  --info: #5AC8FA;
  --text-primary: #000000;
  --text-secondary: #3C3C3C;
  --text-tertiary: #8A8A8E;
  --text-quaternary: #BBBBBC;
  --bg-primary: #FFFFFF;
  --bg-secondary: #F2F2F7;
  --bg-tertiary: #FFFFFF;
  --border: #E5E5E7;
  --border-subtle: #F0F0F0;
  --overlay-80: rgba(255, 255, 255, 0.8);
  --overlay-50: rgba(255, 255, 255, 0.5);
  --overlay-40: rgba(255, 255, 255, 0.4);
  --overlay-20: rgba(255, 255, 255, 0.2);
  --overlay-10: rgba(255, 255, 255, 0.1);
  --overlay-05: rgba(255, 255, 255, 0.05);
  --opacity-disabled: 0.3;
  --opacity-inactive: 0.6;
  --shadow-elev-1: 0 1px 2px rgba(255, 255, 255, 0.08);
  --shadow-elev-2: 0 2px 8px rgba(255, 255, 255, 0.12);
  --shadow-elev-3: 0 4px 16px rgba(255, 255, 255, 0.16);
}

.theme-dark {
  --primary: #0a84ff;
  --success: #30d158;
  --caution: #ffd60a;
  --warning: #ff9f0a;
  --danger: #ff453a;
  --purple: #bf5af2;
  --info: #64d2ff;
  --text-primary: #ffffff;
  --text-secondary: #ebebf5;
  --text-tertiary: #8e8e93;
  --text-quaternary: #68686c;
  --bg-primary: #1c1c1e;
  --bg-secondary: #2c2c2e;
  --bg-tertiary: #3a3a3c;
  --border: #38383a;
  --border-subtle: #424245;
  --overlay-80: rgba(255, 255, 255, 0.8);
  --overlay-50: rgba(255, 255, 255, 0.5);
  --overlay-40: rgba(255, 255, 255, 0.4);
  --overlay-20: rgba(255, 255, 255, 0.2);
  --overlay-10: rgba(255, 255, 255, 0.1);
  --overlay-05: rgba(255, 255, 255, 0.05);
  --opacity-disabled: 0.3;
  --opacity-inactive: 0.6;
  --shadow-elev-1: 0 1px 2px rgba(255, 255, 255, 0.08);
  --shadow-elev-2: 0 2px 8px rgba(255, 255, 255, 0.12);
  --shadow-elev-3: 0 4px 16px rgba(255, 255, 255, 0.16);
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", sans-serif;
  background-color: var(--bg-secondary);
  color: var(--text-primary);
  font-size: 30rpx;
  line-height: 1.47;
  -webkit-font-smoothing: antialiased;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
  border-radius: 40rpx;
  font-size: 34rpx;
  font-weight: 500;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-primary {
  background-color: var(--primary);
  color: #fff;
}

.btn-success {
  background-color: var(--success);
  color: #fff;
}

.btn-warning {
  background-color: var(--warning);
  color: #fff;
}

.btn-danger {
  background-color: var(--danger);
  color: #fff;
}

.card {
  background-color: var(--bg-primary);
  border-radius: 48rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-elev-2, 0 2rpx 6rpx rgba(0, 0, 0, 0.1));
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.desc {
  font-size: 30rpx;
  color: var(--text-tertiary);
