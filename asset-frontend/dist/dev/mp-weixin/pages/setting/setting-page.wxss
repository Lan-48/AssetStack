/* 页面底色：与 Layout 内页一致的二级背景 */
.settings-page.data-v-36d84a6e {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 40rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background-color: #F2F2F7;
}

/* 用户信息卡片：与设置分组卡片视觉层级一致，略增高以容纳头像 */
.user-card.data-v-36d84a6e {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 164rpx;
  margin-bottom: 40rpx;
  padding: 32rpx 40rpx;
  background-color: #FFFFFF;
  border-radius: 40rpx;
  box-sizing: border-box;
}
.user-card__left.data-v-36d84a6e {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}
.user-card__avatar.data-v-36d84a6e {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 9999rpx;
  overflow: hidden;
  background-color: #FFFFFF;
}
.user-card__text.data-v-36d84a6e {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}
.user-card__name.data-v-36d84a6e {
  font-size: 34rpx;
  font-weight: 600;
  color: #000000;
}

/* 会员角标：使用主题语义色，避免硬编码 */
.user-card__badge.data-v-36d84a6e {
  align-self: flex-start;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  background-color: rgba(139, 214, 252, 0.48);
}
.user-card__badge-text.data-v-36d84a6e {
  font-size: 24rpx;
  color: #FFCC00;
}
.user-card__arrow.data-v-36d84a6e {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.45;
  /* 资源朝左，水平翻转后指向右侧 */
  transform: scaleX(-1);
}

/* 设置分组内分割线 */
.row-divider.data-v-36d84a6e {
  width: 100%;
  height: 1px;
  margin: 16rpx 0;
  background-color: #F0F0F0;
}