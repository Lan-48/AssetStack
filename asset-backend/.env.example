# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=asset_db

# 应用配置
APP_PORT=8080
CORS_ORIGIN=http://localhost:5173

# 登录与鉴权配置
JWT_SECRET=asset_stack_dev_secret
JWT_EXPIRES_IN_SECONDS=604800
LOGIN_CODE_EXPIRE_SECONDS=300
LOGIN_CODE_COOLDOWN_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=600
SMS_MOCK_MODE=true

# 阿里云 OSS（私有 Bucket；未配置时上传与读签名接口将返回 503）
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 读签名：是否使用 OSS SigV4（新版 Bucket 常见；链上为 x-oss-* 参数。若仍 403 可对照文档排查 RAM/防盗链）
# 旧桶仅支持 V1 时可设为 false
# OSS_AUTHORIZATION_V4=true
# 读签名有效期（秒），可选
# OSS_SIGN_URL_EXPIRES_SECONDS=3600
# 上传回显用签名有效期（秒），可选
# OSS_UPLOAD_PREVIEW_EXPIRES_SECONDS=1800
